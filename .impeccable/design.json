  "narrative": {
    "northStar": "Primer Product UI",
    "overview": "A manuscript workspace expressed in Primer's familiar product language. Neutral surfaces, native UI sans, compact controls, and explicit states keep the manuscript and the next action legible together. This is the user's approved replacement for the warm cream, forest-green, serif interface; no additional decorative identity is introduced.\n\nThis record describes the integrated workbench, not the isolated preview. Native Primer controls frame the existing local subscription, compilation, selection, and review workflows. Visual consistency must not blur the difference between a proposal, an unconfirmed write, a saved file, and a rendered PDF.\n\nThe approved palette pair is Slate blue light and Graphite dark, applied through Primer semantic roles. Primary actions use blue; review success, warning and danger colors remain independent. The manuscript stays white.",
    "keyCharacteristics": [
      "Primer components and semantic theme tokens are authoritative.",
      "Flat workspace surfaces; restrained depth for paper and dialogs.",
      "Concurrent desktop working context with explicit selection, review, and save states."
    ],
    "rules": [
      {
        "name": "The Semantic Color Rule",
        "body": "Use Primer role tokens for interface color; reserve fixed white paper and manuscript ink for the PDF artifact.",
        "section": "colors"
      },
      {
        "name": "The Source Alignment Rule",
        "body": "Keep source, gutter, and review text on the same 22px line grid; verify source-location behavior when changing it.",
        "section": "typography"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Keep working panes flat; use elevation to distinguish paper and modal overlays.",
        "section": "elevation"
      },
      {
        "name": "The Truthful State Rule",
        "body": "A proposal is not a saved file, and a saved source file is not proof of a rebuilt PDF or a completed agent run.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do use installed Primer components and semantic tokens as the source of truth in both themes.",
      "Do preserve desktop pane concurrency, selection context, keyboard focus, and separate gear/info dialogs.",
      "Do preserve live subscription catalogs, local save status, approval boundaries, and the stated limits of Undo."
    ],
    "donts": [
      "Don't reintroduce cream/forest/serif chrome or invent a decorative brand identity.",
      "Don't replace real model catalogs with fixture options or present test activity as a live agent run.",
      "Don't imply pane drag-reordering, automatic PDF recompilation, or reversibility that the workflow does not provide."
    ]
  }
